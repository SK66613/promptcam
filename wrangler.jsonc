{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promptcam",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
