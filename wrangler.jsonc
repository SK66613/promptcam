{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promptcam",
  "main": "./worker/security-entry.js",
  "compatibility_date": "2026-09-03",
  "keep_vars": true,
  "vars": {
    "PROMPTCAM_ENV": "production"
  },
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_WEBHOOK_SECRET",
      "OPENAI_API_KEY"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "promptcam-prod",
      "database_id": "bba1aaa5-789a-45e3-89b8-b1ef8ced02bb"
    }
  ]
}
